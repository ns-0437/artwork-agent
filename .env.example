# Local development defaults (no secrets). docker-compose.yml already bakes
# these in for local-only use; copy to .env only if you want to override them
# when running services outside Docker.
#
# DATABASE_URL/IMAGE_SERVICE_URL/STORAGE_LOCAL_DIR below use localhost:5433
# etc. because that's correct for a process running directly on your HOST
# (docker-compose maps Postgres's container port 5432 to host port 5433 -
# see infra/docker-compose.yml's postgres service). If you're wondering why
# this doesn't break the worker container, which also loads this file via
# env_file: docker-compose.yml's own `environment:` block for that service
# re-sets these same three keys to the container-network values (postgres:5432,
# not localhost:5433) - Compose file `environment:` always wins over
# `env_file:` for the same key, so this file's host-oriented values are only
# ever actually used when a process runs outside Docker.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/artwork_agent?sslmode=disable
IMAGE_SERVICE_URL=http://localhost:8081
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/artifacts
# Day 5 deploy: set STORAGE_BACKEND=gcs and GCS_BUCKET=your-bucket-name
# instead - internal/storage/gcs.go implements the same Storage interface
# LocalDisk does. Leave both above as-is for local dev.
GCS_BUCKET=
API_BASE_URL=http://localhost:8080
UPLOAD_SIGNING_SECRET=dev-only-insecure-secret
PORT=8080
VITE_API_URL=http://localhost:8080/graphql

# Added Day 4 - leave blank until then.
ANTHROPIC_API_KEY=

# Optional practical fallback for local dev if Anthropic credits aren't
# available - Groq (https://console.groq.com), a fast inference host for
# open models. NOT xAI's Grok (the brief's optional Day 5 comparison target)
# - see CLAUDE.md for how the two are kept distinct. Leave blank if unused.
GROQ_API_KEY=
