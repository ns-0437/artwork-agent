# Local development defaults (no secrets). docker-compose.yml already bakes
# these in for local-only use; copy to .env only if you want to override them
# when running services outside Docker.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/artwork_agent?sslmode=disable
IMAGE_SERVICE_URL=http://localhost:8081
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/artifacts
API_BASE_URL=http://localhost:8080
UPLOAD_SIGNING_SECRET=dev-only-insecure-secret
PORT=8080
VITE_API_URL=http://localhost:8080/graphql

# Added Day 4 - leave blank until then.
ANTHROPIC_API_KEY=
